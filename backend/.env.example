# Backend-only configuration. Never use VITE_ for secrets.
# Server environment variables take precedence over this local file.
# Fill HTTPS addresses and model IDs from the documentation of your own provider.
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=

# Do not guess a model ID or place credentials in browser configuration.
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=

# Supported protocol: OpenAI-compatible POST {BASE_URL}/chat/completions

# Optional read-only retrieval with POST {query,top_k:3} and X-API-Key.
# RAG_ALLOWED_ORIGIN is an exact HTTPS origin without a path or trailing slash.
# Example only: https://rag.example.test (never an active default).
RAG_ALLOWED_ORIGIN=
RAG_SEARCH_URL=
RAG_API_KEY=
